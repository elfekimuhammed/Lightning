diff --git a/lightning/database/driver.py b/lightning/database/driver.py
new file mode 100644
index 0000000..d3ca378
--- /dev/null
+++ b/lightning/database/driver.py
@@ -0,0 +1,51 @@
+"""The one place that picks the SQLite driver: SQLCipher (SQLite + AES-256 page encryption).
+
+Everything else imports ``Row``, ``connect`` and the exception classes from here, never the
+stdlib ``sqlite3`` (whose exceptions and Row type are different classes and would not match).
+"""
+from __future__ import annotations
+
+from sqlcipher3 import dbapi2 as _driver
+
+connect = _driver.connect
+Row = _driver.Row
+Connection = _driver.Connection
+Cursor = _driver.Cursor
+Error = _driver.Error
+DatabaseError = _driver.DatabaseError
+IntegrityError = _driver.IntegrityError
+OperationalError = _driver.OperationalError
+sqlite_version = _driver.sqlite_version
+
+PLAINTEXT_HEADER = b"SQLite format 3\x00"
+
+
+class WrongKeyError(Exception):
+    """The key does not open this database (or the file is not a Lightning database)."""
+
+
+def key_literal(key: str | bytes) -> str:
+    """A SQL literal for PRAGMA key / ATTACH ... KEY. bytes = 32-byte raw key (no KDF)."""
+    if isinstance(key, bytes):
+        if len(key) != 32:
+            raise ValueError("a raw key must be 32 bytes")
+        return f"\"x'{key.hex()}'\""
+    if not key:
+        raise ValueError("an empty passphrase cannot encrypt the database")
+    return "'" + key.replace("'", "''") + "'"
+
+
+def apply_key(conn, key: str | bytes) -> None:
+    conn.execute(f"PRAGMA key = {key_literal(key)}")
+    try:
+        conn.execute("SELECT count(*) FROM sqlite_master").fetchone()
+    except DatabaseError as exc:
+        raise WrongKeyError("This key does not open the database.") from exc
+
+
+def is_plaintext(path) -> bool:
+    try:
+        with open(path, "rb") as fh:
+            return fh.read(16) == PLAINTEXT_HEADER
+    except FileNotFoundError:
+        return False
diff --git a/lightning/database/encrypt.py b/lightning/database/encrypt.py
new file mode 100644
index 0000000..89cb645
--- /dev/null
+++ b/lightning/database/encrypt.py
@@ -0,0 +1,61 @@
+"""One-time conversion of a plaintext Lightning database (and its backups) to SQLCipher."""
+from __future__ import annotations
+
+import os
+import sqlite3 as _plain  # only to replay a hot journal and read the plaintext file
+from pathlib import Path
+
+from . import driver
+
+
+def _export(src: Path, dest: Path, key: str | bytes) -> None:
+    conn = driver.connect(str(src), isolation_level=None)   # no key: reads the plaintext file
+    try:
+        conn.execute(f"ATTACH DATABASE ? AS encrypted KEY {driver.key_literal(key)}", (str(dest),))
+        conn.execute("SELECT sqlcipher_export('encrypted')").fetchone()
+        conn.execute("DETACH DATABASE encrypted")
+    finally:
+        conn.close()
+
+
+def _counts(conn) -> dict[str, int]:
+    names = [r[0] for r in conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")]
+    return {n: conn.execute(f'SELECT count(*) FROM "{n}"').fetchone()[0] for n in names}
+
+
+def encrypt_file(path: Path, key: str | bytes) -> bool:
+    """Encrypt ``path`` in place if it is plaintext. Returns True when it converted the file."""
+    path = Path(path)
+    if not driver.is_plaintext(path):
+        return False
+    plain = _plain.connect(path)            # replays any hot -journal left by a crash
+    before = _counts(plain)
+    ok = plain.execute("PRAGMA integrity_check").fetchone()[0]
+    plain.close()
+    if ok != "ok":
+        raise RuntimeError(f"{path.name} failed its integrity check; not converting it.")
+    tmp = path.with_name(path.name + ".encrypting")
+    tmp.unlink(missing_ok=True)
+    _export(path, tmp, key)
+    check = driver.connect(str(tmp))
+    try:
+        driver.apply_key(check, key)
+        if check.execute("PRAGMA integrity_check").fetchone()[0] != "ok" or _counts(check) != before:
+            raise RuntimeError("Encrypted copy did not match; the original was left untouched.")
+    finally:
+        check.close()
+    os.replace(tmp, path)                   # atomic swap; the plaintext bytes are gone from this name
+    for suffix in ("-journal", "-wal", "-shm"):
+        Path(str(path) + suffix).unlink(missing_ok=True)
+    return True
+
+
+def encrypt_existing(db_path: Path, backups: Path, key: str | bytes) -> list[str]:
+    """Convert the database and every plaintext backup. Returns the file names converted."""
+    done = [db_path.name] if encrypt_file(db_path, key) else []
+    if backups.exists():
+        for old in sorted(backups.glob("lightning_*.db")):
+            if encrypt_file(old, key):
+                done.append(old.name)
+    return done
