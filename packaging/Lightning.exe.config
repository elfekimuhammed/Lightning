<?xml version="1.0" encoding="utf-8"?>
<!-- Lightning loads .NET assemblies (pythonnet's Python.Runtime.dll and the WebView2 SDK) from its own
     folder. A ZIP downloaded in a browser and extracted in Explorer marks every file as coming from the
     internet, and .NET Framework then refuses to load those assemblies, so the window never opens.
     This setting lets .NET Framework load them; it changes nothing else. Shipped next to Lightning.exe
     by packaging/package_app.py and tested in CI on files marked as downloaded. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
